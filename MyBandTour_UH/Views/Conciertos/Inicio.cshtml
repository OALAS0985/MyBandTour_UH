    Layout = "~/Views/Shared/_Layout.cshtml";
}



<div style="text-align: center;">
    <img src="~/Images/a1.jpg" alt="Descripción de la imagen" class="img-responsive" />
    <br />
    <br />
    <br />
    <br />
    <h3>Buscar concierto</h3>
    <label for="nombreConcierto">Nombre de la Banda:</label>
    <input type="text" id="nombre" placeholder="Ingrese el nombre">
    <button onclick="EjecutarBuscaConciertos()" class="button">Buscar</button>
    <br />
    <br />
</div>
<h2 style="text-align: center;">Lista de Conciertos</h2>
<br />

<button class="button" onclick="EjecutarConsultaConciertos();">Lista De conciertos</button>

<table class="table table-bordered">
    <thead id="divLogin">
        <tr>
            <th>Id</th>
            <th>Código</th>
            <th>Banda</th>
