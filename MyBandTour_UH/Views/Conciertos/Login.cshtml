
@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Login Administradores</h2>
<br />
<img style="display: block; margin: 0 auto; width: 300px;" src="~/Images/a1.jpg" alt="Descripción de la imagen" class="img-responsive" />


<div id="divLogin">
